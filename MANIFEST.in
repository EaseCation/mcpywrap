include LICENSE THIRD_PARTY_NOTICES.md README.md CHANGELOG.md CONTRIBUTING.md RELEASING.md
include setup.py
include core/mcpywrap_core/_version.py
recursive-include desktop *.py *.exe *.dll *.cer *.json
include desktop/mcpywrap_assets/macos_capture/mcpy-macos-capture
recursive-include scripts *.py *.ps1
recursive-include native *.cs *.c *.cpp *.h *.cer *.json *.md *.patch *.py *.swift
recursive-include docs *.md
recursive-include tests *.py *.md *.json
recursive-include skills *.md *.yaml *.ps1 *.py *.toml *.json .gitignore
include examples/consumer_prepare/README.md
prune test
prune .local-notes
prune docs/investigations
prune .git
global-exclude __pycache__ *.py[cod] *.cppconfig *.log *.pfx *.p12 *.key
